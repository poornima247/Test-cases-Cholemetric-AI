<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FA">

    <!-- Custom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <LinearLayout
            android:id="@+id/ll_edit_profile_back"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&lt; Settings"
                android:textColor="#3B82F6"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Profile"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- Profile Avatar with miniature camera overlay -->
            <RelativeLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/iv_edit_profile_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_logo_circle" />

                <!-- Miniature camera blue circular overlay -->
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_search_gray"
                    android:background="@drawable/bg_logo_circle"
                    android:backgroundTint="#3B82F6"
                    android:padding="6dp"
                    android:tint="#FFFFFF"
                    android:visibility="gone" />
            </RelativeLayout>

            <!-- Name and title preview -->
            <TextView
                android:id="@+id/tv_edit_profile_preview_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dr. John Doe"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_edit_profile_preview_specialization"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Radiologist"
                android:textColor="#666666"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="24dp" />

            <!-- INPUT FIELDS -->
            <!-- Full Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:textColor="#111111"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_edit_profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_card_white_rounded"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp"
                    android:textColor="#111111"
                    android:hint="Dr. John Doe"
                    android:textColorHint="#888888"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Email Address -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:textColor="#111111"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_edit_profile_email"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_card_white_rounded"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp"
                    android:textColor="#111111"
                    android:hint="johndoe123@gmail.com"
                    android:textColorHint="#888888"
                    android:singleLine="true"
                    android:inputType="textEmailAddress" />
            </LinearLayout>

            <!-- Hospital/Clinic -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hospital/Clinic"
                    android:textColor="#111111"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_edit_profile_hospital"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_card_white_rounded"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp"
                    android:textColor="#111111"
                    android:hint="Enter Hospital name"
                    android:textColorHint="#888888"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Specialization -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Specialization"
                    android:textColor="#111111"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_edit_profile_specialization"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_card_white_rounded"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp"
                    android:textColor="#111111"
                    android:hint="Enter specialization"
                    android:textColorHint="#888888"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Change Password Button Row -->
            <LinearLayout
                android:id="@+id/ll_edit_profile_change_password"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_card_white_rounded"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="32dp">

                <!-- Lock vector icon -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search_gray"
                    android:tint="#111111"
                    android:layout_marginEnd="12dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Change Password"
                    android:textColor="#111111"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right_gray" />
            </LinearLayout>

            <!-- Save Changes blue button -->
            <Button
                android:id="@+id/btn_edit_profile_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Save Changes"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_teal"
                android:backgroundTint="#3B82F6"
                android:layout_marginBottom="24dp"
                android:textAllCaps="false" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
