<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_white_rounded"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:elevation="1dp">

    <!-- Card Top Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_item_patient_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patient ID:P-78123"
            android:textColor="#4A69BD"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <TextView
            android:id="@+id/tv_item_patient_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_item_patient_id"
            android:layout_marginTop="2dp"
            android:text="John Doe"
            android:textColor="#555555"
            android:textSize="14sp"
            android:layout_alignParentStart="true" />

        <TextView
            android:id="@+id/tv_item_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Positive"
            android:textColor="#E02424"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#FDE8E8"
            android:background="@drawable/bg_logo_circle"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <!-- Scan Date -->
    <TextView
        android:id="@+id/tv_item_scan_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="30-09-2025"
        android:textColor="#888888"
        android:textSize="13sp"
        android:layout_marginBottom="12dp" />

    <!-- Measurements Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginBottom="16dp">

        <!-- Max Measurement column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Max Measurement"
                android:textColor="#888888"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tv_item_max_measurement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15.4 mm"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- AI Confidence column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Confidence"
                android:textColor="#888888"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tv_item_confidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="96.3%"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EFEFEF"
        android:layout_marginBottom="12dp" />

    <!-- Card Action Buttons Footer Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- View Report -->
        <LinearLayout
            android:id="@+id/ll_item_view_report"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View Report"
                android:textColor="#4A69BD"
                android:textSize="14sp"
                android:textStyle="bold" />
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right_gray"
                app:tint="#4A69BD"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <!-- Delete Scan -->
        <LinearLayout
            android:id="@+id/ll_item_delete_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_trash_red" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete"
                android:textColor="#FF3B30"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>
